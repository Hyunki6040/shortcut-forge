{
  "name": "Hello Claude",
  "actions": [
    {"ask": "What's your name?", "as": "name"},
    {"if": ["{{name}}", "contains", "Claude"],
     "then": [{"notify": "Hi twin", "body": "Nice to meet another Claude, {{name}}"}],
     "else": [{"notify": "Hi", "body": "Welcome, {{name}}"}]},
    {"storage_set": "last_name", "value": "{{name}}"}
  ]
}
