{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.Hyunki6040/shortcut-forge",
  "title": "Shortcut Forge (Apple Shortcuts MCP)",
  "description": "Apple Shortcuts MCP: build, lint and sign iOS Shortcuts (.shortcut) from Claude, Codex or any LLM.",
  "repository": {
    "url": "https://github.com/Hyunki6040/shortcut-forge",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "shortcut-forge",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SHORTCUT_FORGE_OUT",
          "description": "Output folder for generated shortcuts",
          "isRequired": false
        }
      ]
    }
  ]
}