{
  "name": "Morning Brief",
  "version": "1.0.0",
  "color": "orange",
  "actions": [
    {
      "date": "yyyy-MM-dd",
      "as": "today"
    },
    {
      "ask": "What's on your mind this morning?",
      "as": "mood"
    },
    {
      "llm": "Turn this into a calm 3-line plan for today ({{today}}). Be concrete. Input: {{mood}}",
      "as": "plan"
    },
    {
      "storage_get": "brief_log",
      "as": "log"
    },
    {
      "if": [
        "{{log}}",
        "has any value"
      ],
      "then": [
        {
          "set": "log",
          "to": "{{log}}\n{{today}}: {{mood}}"
        }
      ],
      "else": [
        {
          "set": "log",
          "to": "{{today}}: {{mood}}"
        }
      ]
    },
    {
      "storage_set": "brief_log",
      "value": "{{log}}"
    },
    {
      "reminder_add": "🌤 Review morning plan {{today}}",
      "notes": "{{plan}}",
      "if_missing": "Review morning plan {{today}}"
    },
    {
      "show": "{{plan}}"
    }
  ]
}